{
  "name": "@tau/daemon",
  "version": "1.0.0",
  "private": true,
  "description": "Tau persistence daemon",
  "type": "module",
  "scripts": {
    "build": "TAUD_OPTIMIZE=ReleaseFast bun ../../scripts/taud.ts build",
    "build:debug": "TAUD_OPTIMIZE=Debug bun ../../scripts/taud.ts build",
    "build:fast": "TAUD_OPTIMIZE=ReleaseFast bun ../../scripts/taud.ts build",
    "build:small": "TAUD_OPTIMIZE=ReleaseSmall bun ../../scripts/taud.ts build",
    "check": "bun ../../scripts/taud.ts check",
    "fmt": "bun ../../scripts/zig-tools.ts fmt apps/daemon",
    "fmt:check": "bun ../../scripts/zig-tools.ts fmt:check apps/daemon",
    "hardened:compile": "zig build test:compile -Dfuzz=true",
    "hardened:fmt": "zig build test:fmt",
    "leak-check": "bun ../../scripts/taud.ts leak-check",
    "lint": "bun ../../scripts/zig-tools.ts lint apps/daemon",
    "lsp": "zls --version",
    "test": "bun ../../scripts/taud.ts test"
  }
}
