{
  "name": "tau",
  "version": "1.0.0",
  "private": true,
  "description": "A performance-first, agent-extensible graphical terminal multiplexer powered by Electron, Ghostty VT, and taud",
  "keywords": [
    "electron",
    "ghostty",
    "multiplexer",
    "terminal"
  ],
  "license": "MIT",
  "author": "Tau Contributors",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @tau/desktop dev",
    "build": "bun run --filter @tau/desktop build",
    "preview": "bun run --filter @tau/desktop preview",
    "start": "bun run --filter @tau/desktop start",
    "smoke:package": "bun run --filter @tau/desktop smoke:package",
    "build:taud": "bun run --filter @tau/daemon build",
    "build:vt-web": "bun scripts/build-ghostty-vt-wasm.ts",
    "build:vt-native": "bun scripts/build-ghostty-vt-native.ts",
    "test:taud": "bun run --filter @tau/daemon test",
    "zig:build": "bun run --filter @tau/daemon build",
    "zig:test": "bun run --filter @tau/daemon test",
    "zig:lint": "bun run --filter @tau/daemon lint",
    "zig:fmt": "bun run --filter @tau/daemon fmt",
    "zig:fmt:check": "bun run --filter @tau/daemon fmt:check",
    "zig:hardened:compile": "bun run --filter @tau/daemon hardened:compile",
    "zig:hardened:fmt": "bun run --filter @tau/daemon hardened:fmt",
    "zig:lsp": "bun run --filter @tau/daemon lsp",
    "zig:check": "bun run zig:lint && bun run zig:fmt:check && bun run zig:test",
    "zig:leak-check": "bun run --filter @tau/daemon leak-check",
    "leak:taud": "bun run zig:leak-check",
    "bench": "bun run --filter @tau/desktop bench",
    "bench:latency": "bun run --filter @tau/desktop bench:latency",
    "bench:latency:budget": "bun run --filter @tau/desktop bench:latency:budget",
    "bench:input-priority:budget": "bun run --filter @tau/desktop bench:input-priority:budget",
    "bench:attach:budget": "bun run --filter @tau/desktop bench:attach:budget",
    "bench:soak": "bun run --filter @tau/desktop bench:soak",
    "bench:soak:budget": "bun run --filter @tau/desktop bench:soak:budget",
    "bench:renderer": "bun run --filter @tau/desktop bench:renderer",
    "bench:startup:budget": "bun run --filter @tau/desktop bench:startup:budget",
    "bench:app-soak": "bun run --filter @tau/desktop bench:app-soak",
    "bench:app-soak:hour": "bun run --filter @tau/desktop bench:app-soak:hour",
    "bench:app-soak:budget": "bun run --filter @tau/desktop bench:app-soak:budget",
    "bench:app-trace": "bun run --filter @tau/desktop bench:app-trace",
    "bench:app-trace:summary": "bun run --filter @tau/desktop bench:app-trace:summary",
    "bench:terminal": "bun run --filter @tau/desktop bench:terminal",
    "bench:terminal:budget": "bun run --filter @tau/desktop bench:terminal:budget",
    "bench:taud:budget": "bun run --filter @tau/desktop bench:taud:budget",
    "bench:reload:budget": "bun run --filter @tau/desktop bench:reload:budget",
    "bench:ipc": "bun run --filter @tau/desktop bench:ipc",
    "bench:ipc:budget": "bun run --filter @tau/desktop bench:ipc:budget",
    "bench:cross": "bun run --filter @tau/desktop bench:cross",
    "bench:startup": "bun run --filter @tau/desktop bench:startup",
    "bench:all": "bun run --filter @tau/desktop bench:all",
    "bench:tooling": "bun scripts/bench-tooling.ts",
    "test": "bun run test:persistence && bun test scripts/",
    "test:persistence": "bun run --filter @tau/desktop test:persistence",
    "test:surface": "bun run --filter @tau/desktop test:surface",
    "postinstall": "bun scripts/electron-install.ts",
    "fmt": "bun run fmt:ts && bun run zig:fmt",
    "fmt:check": "bun run fmt:ts:check && bun run zig:fmt:check",
    "fmt:ts": "oxfmt .",
    "fmt:ts:check": "oxfmt --check .",
    "fmt:nix": "nix develop --command nixpkgs-fmt flake.nix",
    "fmt:nix:check": "nix develop --command nixpkgs-fmt --check flake.nix",
    "lint": "bun run --filter @tau/desktop --filter @tau/shared lint && bun run zig:lint",
    "lint:fix": "bun run --filter @tau/desktop --filter @tau/shared lint:fix",
    "check": "bun run lint && bun run fmt:check && bun run tsc && bun run test && bun run zig:test",
    "check:fix": "bun run lint:fix && bun run fmt",
    "tsc": "bun x --no-install --bun tsc --noEmit -p tsconfig.scripts.json && bun run --filter @tau/desktop tsc",
    "report:artifacts": "bun scripts/artifact-inventory.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "oxfmt": "^0.70.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild"
  ]
}
